    "C_excess_MWh": "sum(max(pre_bess_local_residual_mw - C, 0) * dt_seconds / 3600) over ticks where residual > C; represents BESS energy required above cap under D1",
    "C_plus_BESS_excess_MWh": "sum(max(pre_bess_local_residual_mw - C - total_configured_BESS_rated_mw, 0) * dt_seconds / 3600) over ticks where residual > C + BESS rated MW; indicative energy above combined limit",
