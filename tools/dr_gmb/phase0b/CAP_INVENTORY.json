    "grid_import_mw": "max(0, -TickResult.grid_exchange_mw); grid_exchange_mw positive means export",
    "peak_time": "TickResult interval-end sim_time_seconds",
    "pre_bess_local_residual_mw": "p_demand_mw - turbine_output_mw - diesel_output_mw - fuel_cell_output_mw - p_renewable_mw"
  },
