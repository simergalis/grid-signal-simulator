modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
# Step 16 / §10.2: Reserved VM.
# Always-On alone does not prevent a non-Reserved Repl from sleeping on inactivity,
# which kills long scenario runs mid-demonstration. The gridsignal sim is stateful
# in-process (RunManager, WebSocketHub) — autoscale cold-start kills in-flight
# WebSocket runs.
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
